# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default in a Next.js app - never commit real credentials.

# --- SMTP (sends through the company's own mailbox, e.g. contact@deansgroupofcompanies.com) ---
# Ask whoever manages that mailbox (Google Workspace / Microsoft 365 / cPanel) for an
# SMTP host/port and an APP PASSWORD (not the normal login password) for it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" only if your provider requires this on port 465 (implicit TLS). Most app-password
# setups on port 587 use STARTTLS instead and should leave this "false".
SMTP_SECURE=false
SMTP_USER=contact@deansgroupofcompanies.com
SMTP_PASSWORD=replace-with-a-real-app-password

# Shown as the "From" address on every email this site sends.
MAIL_FROM="Deans Group of Companies <contact@deansgroupofcompanies.com>"
# Where admin notification emails (the full submission details) are sent.
ADMIN_EMAIL=contact@deansgroupofcompanies.com

# --- Google reCAPTCHA v3 ---
# Register the site at https://www.google.com/recaptcha/admin to get these two keys.
# The site key is public (shipped to the browser); the secret key must stay server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-a-real-site-key
RECAPTCHA_SECRET_KEY=replace-with-a-real-secret-key
